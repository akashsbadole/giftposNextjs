// This is your Prisma schema file for Retail Store POS System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Store configuration
model Store {
  id           String   @id @default(cuid())
  name         String
  address      String?
  phone        String?
  email        String?
  taxRate      Float    @default(0)  // Legacy field, kept for compatibility
  gstRate      Float    @default(0)  // GST percentage (e.g., 5, 10, 15)
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  categories         Category[]
  products           Product[]
  customers          Customer[]
  sales              Sale[]
  employees          Employee[]
  printers           Printer[]
  paymentProviders   PaymentProvider[]
  heldOrders         HeldOrder[]
  orderAnalytics      OrderAnalytics[]
  workflowRules       WorkflowRule[]
}

// Category for organizing products
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  color     String?
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Product inventory
model Product {
  id          String    @id @default(cuid())
  sku         String    @unique
  barcode     String?   @unique
  name        String
  description String?
  price       Float
  cost        Float     @default(0)
  stock       Int       @default(0)
  minStock    Int       @default(0)  // Low stock threshold
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  images      String?   // JSON array of image URLs
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  saleItems   SaleItem[]
  stockLogs   StockLog[]
}

// Customer management
model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  points    Int      @default(0) // Loyalty points
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales     Sale[]
  heldOrders HeldOrder[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Employee/Staff
model Employee {
  id        String   @id @default(cuid())
  clerkId   String?  @unique  // Clerk user ID for authentication
  name      String
  email     String?  @unique  // Optional - not always available from Clerk
  phone     String?
  role      String   @default("staff") // admin, manager, staff
  isActive  Boolean  @default(true)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales     Sale[]
  heldOrders HeldOrder[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Sales transaction
model Sale {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  subtotal      Float
  tax           Float     @default(0)  // Legacy field
  gst           Float     @default(0)  // GST amount
  discount      Float     @default(0)
  total         Float
  paymentMethod String   // cash, card, digital
  status        String    @default("completed") // pending, completed, cancelled, refunded
  notes         String?
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  items           SaleItem[]
  payment         Payment?
  transactions    PaymentTransaction[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Items in a sale
model SaleItem {
  id        String   @id @default(cuid())
  quantity  Int
  price     Float
  subtotal  Float
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

// Payment details
model Payment {
  id             String   @id @default(cuid())
  saleId         String   @unique
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount         Float
  method         String   // cash, card, digital
  reference      String?  // Transaction ID, card last 4, etc.
  status         String   @default("completed") // pending, completed, failed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Performance Metrics for monitoring
model PerformanceMetric {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  operation     String   // API endpoint, DB operation, etc.
  duration      Float    // Duration in milliseconds
  memoryUsage   Float?   // Memory used in bytes
  cpuUsage      Float?   // CPU time in microseconds
  success       Boolean
  errorMessage  String?
  metadata      String?  // JSON additional data
  userId        String?
  sessionId     String?
  route         String?
  method        String?
  createdAt     DateTime @default(now())
  
  @@index([operation, timestamp])
  @@index([duration])
  @@index([success])
  @@index([userId])
}

// Error Aggregation for deduplication
model ErrorAggregate {
  id            String   @id @default(cuid())
  fingerprint   String   @unique // Unique identifier for error type
  message       String
  type          String
  count         Int      @default(1)
  firstOccurrence DateTime @default(now())
  lastOccurrence  DateTime @default(now())
  resolved      Boolean  @default(false)
  resolvedAt    DateTime?
  resolvedBy    String?
  userImpact    String?  // low, medium, high, critical
  affectedUsers String?  // JSON array of affected user IDs
  tags          String?  // JSON array of tags
  context       String?  // JSON error context
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([fingerprint])
  @@index([resolved])
  @@index([lastOccurrence])
}

// System Health Monitoring
model SystemHealth {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  status        String   // healthy, degraded, critical
  memoryUsage   Float    // Memory usage in MB
  cpuUsage      Float    // CPU usage percentage
  diskUsage     Float?   // Disk usage percentage
  activeConnections Int
  responseTime  Float    // Average response time in ms
  errorRate     Float    // Error rate percentage
  uptime        Float    // System uptime in seconds
  version       String?  // Application version
  createdAt     DateTime @default(now())
  
  @@index([timestamp])
  @@index([status])
}

// Stock movement logs
model StockLog {
  id          String   @id @default(cuid())
  quantity    Int      // Positive for restock, negative for sale
  type        String   // sale, restock, return, adjustment, damage
  reason      String?
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  employeeId  String?  // Who made the change
  createdAt   DateTime @default(now())
}

// Printer device management
model Printer {
  id            String   @id @default(cuid())
  name          String
  type          String   // thermal, inkjet, label, laser
  brand         String   // epson, star, tvs, hp, canon, etc.
  model         String
  connection    String   // usb, bluetooth, network, wifi
  status        String   @default("offline") // online, offline, error, printing
  isDefault     Boolean  @default(false)
  settings      String?  // JSON string with printer-specific settings
  capabilities  String?  // JSON string with printer capabilities
  lastConnected DateTime?
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  printJobs     PrintJob[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Print job queue
model PrintJob {
  id         String   @id @default(cuid())
  type       String   // receipt, invoice, label, report
  content    String   // Content to print (ESC/POS commands, text, etc.)
  status     String   @default("pending") // pending, printing, completed, failed
  priority   Int      @default(0) // Higher numbers = higher priority
  retryCount Int      @default(0)
  error      String?  // Error message if failed
  printerId  String
  printer    Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  startedAt  DateTime?
  completedAt DateTime?
}

// Payment Provider Configuration
model PaymentProvider {
  id          String   @id @default(cuid())
  name        String   // paytm, pinelabs, razorpay, etc.
  displayName String   // Display name for UI
  type        String   // terminal, api, hybrid
  isActive    Boolean  @default(true)
  config      String?  // JSON configuration (API keys, endpoints, etc.)
  capabilities String? // JSON array of supported payment methods
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  terminals   TerminalIntegration[]
  transactions PaymentTransaction[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Payment Terminal Integration
model TerminalIntegration {
  id            String   @id @default(cuid())
  name          String   // Terminal name/identifier
  serialNumber  String?  // Hardware serial number
  terminalId    String   // Provider terminal ID
  model         String?  // Terminal model (e.g., Paytm Soundbox, PineLabs Ezetap)
  status        String   @default("offline") // online, offline, error, busy
  lastHeartbeat DateTime? // Last communication timestamp
  capabilities  String?  // JSON array of supported features
  settings      String?  // JSON terminal-specific settings
  providerId    String
  provider      PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  transactions  PaymentTransaction[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Payment Transaction
model PaymentTransaction {
  id              String   @id @default(cuid())
  transactionId   String?  // Provider transaction ID
  orderId         String?  // Internal order reference
  amount          Float
  currency        String   @default("INR")
  paymentMethod   String   // card_swipe, upi, wallet, emi, netbanking
  status          String   @default("pending") // pending, processing, completed, failed, cancelled, refunded
  providerStatus  String?  // Raw status from provider
  customerInfo    String?  // JSON customer details
  responseData    String?  // JSON full response from provider
  failureReason   String?  // Error message if failed
  refundAmount    Float?   // Amount refunded
  refundReason    String?  // Reason for refund
  terminalId      String?
  terminal        TerminalIntegration? @relation(fields: [terminalId], references: [id])
  providerId      String
  provider        PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  saleId          String?
  sale            Sale?    @relation(fields: [saleId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?
}

// Audit Log for security tracking
model AuditLog {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  userId         String?  // Clerk user ID
  userEmail      String?
  action         String   // What action was performed
  resource       String   // What resource was accessed
  resourceId     String?  // ID of the specific resource
  method         String   // HTTP method used
  path           String   // API path or route
  ipAddress      String?
  userAgent      String?
  status         String   @default("success") // success, failure, warning
  severity       String   @default("low") // low, medium, high, critical
  details        String?  // JSON additional details
  previousValues String?  // JSON previous values (for updates)
  newValues      String?  // JSON new values (for updates)
  sessionId      String?
  correlationId  String   // For request tracing
  createdAt      DateTime @default(now())
}

// Security Events for monitoring
model SecurityEvent {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  eventType   String   // failed_login, rate_limit_exceeded, suspicious_activity, etc.
  severity    String   @default("low") // low, medium, high, critical
  userId      String?
  userEmail   String?
  ipAddress   String?
  userAgent   String?
  path        String?
  method      String?
  description String   // Human-readable description
  details     String?  // JSON additional details
  resolved    Boolean  @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  prevention  String?  // JSON array of prevention measures
  createdAt   DateTime @default(now())
}

// Error Log for comprehensive error tracking
model ErrorLog {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  level          String   // debug, info, warn, error, critical
  type           String   // application, security, audit, performance, business, error
  message        String
  data           String?  // JSON additional data
  userId         String?
  userEmail      String?
  sessionId      String?
  requestId      String?
  route          String?
  method         String?
  ipAddress      String?
  userAgent      String?
  source         String   @default("backend") // frontend, backend, api, worker, cron
  environment    String   @default("development")
  correlationId  String?
  stackTrace     String?
  isSensitive    Boolean  @default(false)
  tags           String?  // JSON array of tags
  fingerprint    String?  // For error deduplication
  errorCode      String?  // Custom error code
  userImpact     String?  // low, medium, high, critical
  retryable      Boolean? // Whether error can be retried
  resolved       Boolean  @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([level, type, timestamp])
  @@index([fingerprint])
  @@index([correlationId])
  @@index([userId])
  @@index([resolved])
}

// Support Ticket System
model SupportTicket {
  id            String   @id @default(cuid())
  ticketId      String   @unique @default(cuid()) // Human-readable ticket ID
  userId        String?  // Clerk user ID
  userEmail     String?  // User's email
  userName      String?
  title         String
  description   String
  category      String   // Technical Issue, Billing, Feature Request, General Question
  priority      String   @default("medium") // low, medium, high, critical
  status        String   @default("open") // open, in_progress, resolved, closed
  attachments   String?  // JSON array of attachment URLs
  systemInfo    String?  // JSON system information
  resolution    String?  // Resolution notes
  resolvedBy    String?  // Staff member who resolved it
  resolvedAt    DateTime?
  customerId    String?  // Optional link to customer
  storeId       String?  // Store ID if applicable
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Knowledge Base Articles
model KnowledgeBaseArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   // HTML or Markdown content
  summary     String?  // Short description for search results
  category    String   // FAQ, Getting Started, Troubleshooting, Keyboard Shortcuts, etc.
  tags        String?  // JSON array of tags
  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  viewCount   Int      @default(0)
  helpful     Int      @default(0) // Count of helpful votes
  notHelpful  Int      @default(0) // Count of not helpful votes
  author      String?  // Author name
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Error Reports
model ErrorReport {
  id            String   @id @default(cuid())
  reportId      String   @unique @default(cuid()) // Human-readable report ID
  userId        String?  // Clerk user ID
  userEmail     String?
  title         String
  description   String
  errorType     String   // JavaScript Error, Network Error, UI Bug, Performance Issue
  severity      String   @default("medium") // low, medium, high, critical
  url           String?  // Page where error occurred
  userAgent     String?
  browser       String?
  os            String?
  screenshot    String?  // Screenshot data URL
  stackTrace    String?  // JavaScript stack trace
  consoleLogs   String?  // Console logs
  systemInfo    String?  // JSON system information
  status        String   @default("new") // new, investigating, resolved, dismissed
  resolvedBy    String?
  resolvedAt    DateTime?
  resolution    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Held Orders for POS - Open/Hold Orders System
model HeldOrder {
  id            String   @id @default(cuid())
  orderNumber   String   @unique // Human-readable order ID
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  tableNumber   String?   // For restaurant use
  orderName     String?   // Custom order name/description
  itemsData     String    // JSON string of cart items
  subtotal      Float
  gst           Float     @default(0)
  discount      Float     @default(0)
  total         Float
  notes         String?
  status        String    @default("held") // held, retrieved, completed, cancelled, expired
  priority      Int       @default(0) // For sorting/priority
  holdDuration  Int?      // Duration in minutes before auto-expire
  isAutoSaved   Boolean   @default(false) // Whether this was auto-saved
  tags          String?   // JSON array of tags for organization
  metadata      String?   // JSON additional metadata
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  retrievedAt   DateTime?
  expiredAt     DateTime?
  collaborationSessions CollaborationSession[]
  orderLocks     OrderLock[]
  
  @@index([storeId, status])
  @@index([customerId])
  @@index([employeeId])
  @@index([createdAt])
  @@index([status, priority])
  @@index([tableNumber])
}

// Collaboration Session Model for real-time multi-user collaboration
model CollaborationSession {
  id            String   @id @default(cuid())
  sessionId     String   @unique // Unique session identifier
  heldOrderId   String   // Link to held order being collaborated on
  heldOrder     HeldOrder @relation(fields: [heldOrderId], references: [id], onDelete: Cascade)
  userId        String   // Clerk user ID
  userEmail     String?
  userName      String
  role          String   @default("collaborator") // owner, editor, viewer, collaborator
  isActive      Boolean  @default(true)
  lastSeenAt    DateTime @default(now())
  cursorPosition String? // JSON string of cursor/selection data
  editLock      String?  // Field being edited (for granular locking)
  heartbeatAt   DateTime @default(now()) // For detecting stale sessions
  metadata      String?  // JSON additional session metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([heldOrderId])
  @@index([userId])
  @@index([sessionId])
  @@index([isActive])
  @@index([heartbeatAt])
}

// Order Lock Model to prevent conflicts during simultaneous edits
model OrderLock {
  id            String   @id @default(cuid())
  heldOrderId   String   @unique // Only one lock per order
  heldOrder     HeldOrder @relation(fields: [heldOrderId], references: [id], onDelete: Cascade)
  userId        String   // Clerk user ID who owns the lock
  userEmail     String?
  userName      String
  lockType      String   @default("full") // full, items, customer, payment, metadata
  lockScope     String   @default("exclusive") // exclusive, shared, read
  reason        String?  // Reason for locking (manual, automatic, etc.)
  isActive      Boolean  @default(true)
  expiresAt     DateTime? // Optional expiration time
  acquiredAt    DateTime @default(now())
  lastRenewedAt DateTime @default(now())
  metadata      String?  // JSON additional lock metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([heldOrderId])
  @@index([userId])
  @@index([isActive])
  @@index([expiresAt])
}

// Order Analytics Model for operational insights
model OrderAnalytics {
  id                String   @id @default(cuid())
  date              DateTime // Date for analytics (truncated to day)
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  // Basic metrics
  totalOrders       Int      @default(0)
  completedOrders   Int      @default(0)
  cancelledOrders   Int      @default(0)
  expiredOrders     Int      @default(0)
  
  // Financial metrics
  totalRevenue      Float    @default(0)
  avgOrderValue     Float    @default(0)
  totalDiscounts    Float    @default(0)
  totalGST          Float    @default(0)
  
  // Time-based metrics
  avgProcessingTime Float    @default(0) // Average time to complete orders (in minutes)
  avgHoldDuration   Float    @default(0) // Average time orders are held (in minutes)
  peakHourOrders    Int      @default(0) // Orders during peak hour
  
  // User activity
  activeUsers       Int      @default(0) // Unique users who processed orders
  collaborativeSessions Int @default(0) // Number of collaboration sessions
  
  // Category breakdown
  categoryBreakdown String?  // JSON of orders by category
  productBreakdown  String?  // JSON of most ordered products
  
  // Additional metrics
  customMetrics     String?  // JSON additional custom metrics
  metadata          String?  // JSON additional metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([date, storeId])
  @@index([date])
  @@index([storeId])
  @@index([totalRevenue])
}

// Workflow Rule Model for automated processes
model WorkflowRule {
  id            String   @id @default(cuid())
  name          String   // Human-readable rule name
  description   String?  // Description of what the rule does
  isActive      Boolean  @default(true)
  priority      Int      @default(0) // Higher numbers = higher priority
  
  // Trigger conditions
  triggerType   String   // order_created, order_updated, order_completed, time_based, manual
  triggerConditions String // JSON conditions that must be met
  
  // Rule configuration
  conditions    String?  // JSON additional conditions
  actions       String   // JSON array of actions to execute
  
  // Execution settings
  maxExecutions Int      @default(1) // Max times this rule can execute
  executionCount Int     @default(0)
  lastExecutedAt DateTime?
  nextExecutionAt DateTime? // For time-based triggers
  
  // Error handling
  errorCount    Int      @default(0)
  lastError     String?
  
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  workflowActions WorkflowAction[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([storeId])
  @@index([isActive])
  @@index([priority])
  @@index([triggerType])
  @@index([nextExecutionAt])
}

// Workflow Action Model for tracking rule executions
model WorkflowAction {
  id            String   @id @default(cuid())
  ruleId        String
  rule          WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  
  // Execution details
  executionId   String   @unique // Unique execution identifier
  status        String   @default("pending") // pending, running, completed, failed, cancelled
  
  // Action details
  actionType    String   // notification, email, webhook, sms, data_update, custom
  actionConfig  String   // JSON configuration for the action
  
  // Execution context
  contextData   String?  // JSON context data (order info, user info, etc.)
  
  // Results
  result        String?  // JSON result of action execution
  errorMessage  String?  // Error message if failed
  
  // Timing
  startedAt     DateTime?
  completedAt   DateTime?
  duration      Float?   // Execution duration in milliseconds
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([ruleId])
  @@index([executionId])
  @@index([status])
  @@index([actionType])
  @@index([startedAt])
}

// Job Queue Model for managing automated lifecycle tasks
model JobQueue {
  id            String   @id @default(cuid())
  jobId         String   @unique // Unique job identifier
  type          String   // order_cleanup, analytics_update, notification, reminder, sync, custom
  
  // Job configuration
  jobData       String   // JSON job payload
  priority      Int      @default(0) // Higher numbers = higher priority
  
  // Scheduling
  scheduledAt   DateTime // When job should run
  startedAt     DateTime? // When job actually started
  completedAt   DateTime? // When job finished
  
  // Execution status
  status        String   @default("pending") // pending, running, completed, failed, cancelled, retrying
  attempts      Int      @default(0)
  maxAttempts   Int      @default(3)
  
  // Results
  result        String?  // JSON result data
  errorMessage  String?  // Error message if failed
  errorStack    String?  // Error stack trace
  
  // Dependencies and relationships
  dependsOn     String?  // JSON array of job IDs this job depends on
  parentJobId   String?  // ID of parent job (for job chains)
  
  // Metadata
  metadata      String?  // JSON additional metadata
  storeId       String?  // Optional store context
  userId        String?  // Optional user context
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([jobId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([scheduledAt])
  @@index([startedAt])
  @@index([storeId])
  @@index([parentJobId])
}